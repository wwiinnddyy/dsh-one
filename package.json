{
  "name": "@wwiinnddyy/dsh-one",
  "version": "0.2.0",
  "description": "DSH One: session registry, delegated task runtime, source intake, and a read-only panel for DeepSeek Harness.",
  "license": "GPL-3.0",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./delegate": {
      "types": "./lib/types/delegate.d.ts",
      "default": "./lib/delegate.js"
    },
    "./ingress": {
      "types": "./lib/types/ingress.d.ts",
      "default": "./lib/ingress.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.4 <0.3.0-0"
  },
  "scripts": {
    "clean": "node scripts/clean-lib.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "One",
      "en": "One"
    },
    "icon": "bot",
    "contributes": {
      "composer.strip": [
        {
          "id": "one",
          "icon": "pending",
          "panel": "one"
        }
      ],
      "panels": [
        {
          "id": "one",
          "title": {
            "zh": "任务",
            "en": "Tasks"
          },
          "icon": "todo",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwiinnddyy/dsh-one.git"
  }
}
